// .vscode/tasks.json
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++ Project",
      "type": "shell",
      // Now we simply invoke "g++" (because it's on PATH).
      "command": "g++",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-std=c++17",
        "main.cpp",
        "MatchScheduler.cpp",
        "ResultLogger.cpp",
        // If you have additional .cpp files, list them here, e.g.:
        // "PlayerRegistration.cpp",
        // "SpectatorManager.cpp",
        "-o",
        "app.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Builds main.cpp, MatchScheduler.cpp, and ResultLogger.cpp using g++"
    }
  ]
}
